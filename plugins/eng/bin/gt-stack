// modules/gather-cli/src/gitFlow/gitRepo.ts
var currentBranch = async () => await getOutputSilent(() => $`git rev-parse --abbrev-ref HEAD`);
var gitCommonDir = async () => await getOutputSilent(() => $`git rev-parse --git-common-dir`);
var isInWorktree = async () => {
  const gitDir = await getOutputSilent(() => $`git rev-parse --git-dir`);
  return gitDir !== await gitCommonDir();
};
var verifyNoUncommittedChangesOrThrow = async () => {
  const changes = await getOutputSilent(() => $`git status --porcelain=v1`);
  if (!isBlank(changes)) {
    Logger2.error(`
There are tracked changes that have not been committed in git.
Discard, stash, or commit them and then retry this command.
`);
    throw new Error("Uncommitted changes present");
  }
  Logger2.info("\u2705 No uncommitted changes detected");
};

// modules/gather-cli/src/gitFlow/graphiteMetadata.ts
var import_node_sqlite = require("node:sqlite");
var import_fs = require("fs");

// modules/gather-common-including-video/src/errors.ts
var import_helpers4 = __toESM(require_helpers());

// modules/gather-cli/src/gitFlow/graphiteMetadata.ts
var MAX_STACK_DEPTH = 1e3;
var ForkError = (0, import_helpers4.createErrorClass)("ForkError", {
  defaultMessage: (m) => `fork upstack at ${m.branch}: ${m.children.length} children`
});
var UntrackedBranchError = (0, import_helpers4.createErrorClass)("UntrackedBranchError", {
  defaultMessage: (m) => `branch '${m.branch}' is not tracked by Graphite`
});
var StackTooLargeError = (0, import_helpers4.createErrorClass)("StackTooLargeError", {
  defaultMessage: `stack exceeds ${MAX_STACK_DEPTH} branches \u2014 possible cycle in Graphite metadata`
});
var parseSqliteRow = (row) => {
  const parent = String(row.parent_branch_name ?? "") || null;
  const childrenRaw = String(row.children);
  try {
    return { parent, children: JSON.parse(childrenRaw) };
  } catch {
    return { parent, children: [] };
  }
};
var buildSqliteReader = (dbPath) => ({
  async read(branch) {
    const query = "SELECT parent_branch_name, COALESCE(children, '[]') AS children FROM branch_metadata WHERE branch_name = ?";
    try {
      const database = new import_node_sqlite.DatabaseSync(dbPath, { readOnly: true });
      try {
        const row = database.prepare(query).get(branch);
        if (!row) return null;
        return parseSqliteRow(row);
      } finally {
        database.close();
      }
    } catch {
      return null;
    }
  }
});
var readTrunk = (repoConfigPath) => {
  const raw = (0, import_fs.readFileSync)(repoConfigPath, "utf8");
  const config = JSON.parse(raw);
  if (!config.trunk) throw new Error("Missing 'trunk' in .graphite_repo_config");
  return config.trunk;
};
var readPrInfos = (prInfoPath) => {
  const raw = (0, import_fs.readFileSync)(prInfoPath, "utf8");
  const parsed = JSON.parse(raw);
  return parsed.prInfos ?? [];
};
var safeReadPrInfos = (prInfoPath) => {
  try {
    return readPrInfos(prInfoPath);
  } catch {
    return [];
  }
};
var walkUp = async (reader, start) => {
  const result = [];
  let current = start;
  for (let i = 0; i < MAX_STACK_DEPTH; i++) {
    const node = await reader.read(current);
    const children = node?.children ?? [];
    if (isEmpty(children)) return result;
    if (children.length > 1) throw new ForkError(void 0, { branch: current, children });
    current = children[0];
    result.push(current);
  }
  throw new StackTooLargeError();
};
var walkDown = async (reader, start, trunk) => {
  const result = [];
  let current = start;
  for (let i = 0; i < MAX_STACK_DEPTH; i++) {
    const node = await reader.read(current);
    const parent = node?.parent ?? null;
    if ((0, import_helpers3.isNil)(parent) || parent === trunk) return result;
    result.push(parent);
    current = parent;
  }
  throw new StackTooLargeError();
};
var buildFullStack = async (reader, start, trunk) => {
  const startNode = await reader.read(start);
  if ((0, import_helpers3.isNil)(startNode)) throw new UntrackedBranchError(void 0, { branch: start });
  const ups = await walkUp(reader, start);
  const downs = await walkDown(reader, start, trunk);
  return [...ups.slice().reverse(), start, ...downs];
};

// modules/gather-cli/src/commands/stack/list.ts
var StackList = class _StackList extends import_core.Command {
  static summary = "Print the branches of the current Graphite stack, top to bottom (read-only)";
  static description = [
    "Exit codes: 0 when the branch is tracked and the stack printed, 1 when the branch is tracked but forks upstack, 2 when the branch isn't tracked by Graphite, and 3 when the Graphite repo config is missing or invalid, so tracking is unknown. Other failures can exit 1 or 2 too.",
    "",
    "--json prints one entry per branch with branch, prNumber, title, url, state, isDraft, baseRefName, headRefName and reviewDecision. A field is null when the branch has no PR metadata."
  ].join("\n");
  static examples = [
    "# print the current stack",
    "$ <%= config.bin %> <%= command.id %>",
    "# print the stack starting from a specific branch",
    "$ <%= config.bin %> <%= command.id %> --from andrew/my-feature",
    "# print as JSON with PR metadata",
    "$ <%= config.bin %> <%= command.id %> --json"
  ];
  static flags = {
    from: import_core.Flags.string({ description: "starting branch (default: current branch)" }),
    json: import_core.Flags.boolean({ description: "output as JSON with PR metadata" })
  };
  async run() {
    const { flags } = await this.parse(_StackList);
    const startBranch = flags.from ?? await currentBranch();
    const commonDir = await gitCommonDir();
    const dbPath = path3.join(commonDir, ".graphite_metadata.db");
    const repoConfigPath = path3.join(commonDir, ".graphite_repo_config");
    const reader = buildSqliteReader(dbPath);
    const trunk = doIt(() => {
      try {
        return readTrunk(repoConfigPath);
      } catch {
        this.error(
          "Graphite repo config not found or invalid. Is this a Graphite-tracked repository?",
          { exit: 3 }
        );
      }
    });
    const stack = await this.resolveStack(reader, startBranch, trunk);
    if (flags.json) {
      const prInfoPath = path3.join(commonDir, ".graphite_pr_info");
      const prByBranch = indexBy_default((pr) => pr.headRefName, safeReadPrInfos(prInfoPath));
      const entries = stack.map((branch) => this.buildPrEntry(branch, prByBranch[branch]));
      Logger2.log(JSON.stringify(entries, null, 2));
    } else {
      for (const branch of stack) {
        Logger2.log(branch);
      }
    }
  }
  buildPrEntry(branch, pr) {
    return {
      branch,
      prNumber: pr?.prNumber ?? null,
      title: pr?.title ?? null,
      url: pr?.url ?? null,
      state: pr?.state ?? null,
      isDraft: pr?.isDraft ?? null,
      baseRefName: pr?.baseRefName ?? null,
      headRefName: pr?.headRefName ?? null,
      reviewDecision: pr?.reviewDecision ?? null
    };
  }
  async resolveStack(reader, startBranch, trunk) {
    try {
      return await buildFullStack(reader, startBranch, trunk);
    } catch (e) {
      if (e instanceof ForkError) {
        const { branch, children } = e.metadata;
        const childList = children.map((c) => `  - ${c}`).join("\n");
        this.error(
          `fork upstack at ${branch}: ${children.length} children. Pick one as the start:
${childList}`,
          { exit: 1 }
        );
      }
      if (e instanceof UntrackedBranchError) {
        this.error(
          `branch '${e.metadata.branch}' is not tracked by Graphite. Run \`gt track\` to track it.`,
          { exit: 2 }
        );
      }
      throw e;
    }
  }
};

// modules/gather-cli/src/commands/stack/merge.ts
var path4 = __toESM(require("path"));
var import_core2 = __toESM(require_lib());

// modules/gather-common-including-video/src/promises.ts
var import_helpers5 = __toESM(require_helpers());
var sleep2 = async (ms, signal) => new Promise((resolve) => {
  if (signal?.aborted) {
    resolve();
    return;
  }
  const timeout = setTimeout(() => {
    resolve();
  }, ms);
  signal?.addEventListener("abort", () => {
    clearTimeout(timeout);
    resolve();
  });
});

// modules/gather-common/src/asyncRetry.ts
var asyncRetryWith = async (fn, options) => {
  let result = await fn(void 0);
  for (const delayMs of options.delaysMs) {
    if (options.stopRetry(result)) return result;
    await sleep2(delayMs);
    if (options.shouldContinue && !options.shouldContinue()) return result;
    result = await fn(result);
  }
  return result;
};

// modules/gather-cli/src/gitFlow/stackMerge.ts
var DO_NOT_MERGE_MARKER = "[do not merge]";
var BranchNotInStackError = (0, import_helpers4.createErrorClass)("BranchNotInStackError", {
  defaultMessage: (m) => `branch '${m.branch}' is not in the current stack`
});
var UnmergeableToError = (0, import_helpers4.createErrorClass)(
  "UnmergeableToError",
  {
    defaultMessage: (m) => `'${m.branch}' ${m.reason}, so the requested --to range can't be merged`
  }
);
var UnexpectedMergeBaseError = (0, import_helpers4.createErrorClass)("UnexpectedMergeBaseError", {
  defaultMessage: (m) => `#${m.prNumber} targets '${m.baseRefName}', not '${m.trunk}'. Squashing it now would land its commits on a stack branch instead of trunk, so it was left unmerged. Branches earlier in the range may already have landed on ${m.trunk}.`
});
var MergeabilityUnknownError = (0, import_helpers4.createErrorClass)(
  "MergeabilityUnknownError",
  {
    defaultMessage: (m) => `GitHub still reports mergeable: ${m.mergeable || "<empty>"} for #${m.prNumber}, so it hasn't finished recomputing mergeability for the current head \u2014 or that PR is already closed or merged, which reads the same. Nothing was merged for this branch. Branches earlier in the range may already have landed.`
  }
);
var DoNotMergeError = (0, import_helpers4.createErrorClass)("DoNotMergeError", {
  defaultMessage: (m) => `#${m.prNumber} is marked ${DO_NOT_MERGE_MARKER} on GitHub, so it was left unmerged. Branches earlier in the range may already have landed.`
});
var resolveMergeRange = (fullStackTopToBottom, to, prByBranch) => {
  const bottomToTop = fullStackTopToBottom.slice().reverse();
  if ((0, import_helpers3.isNil)(to)) return { toMerge: bottomToTop, endBranch: null };
  const toIndex = bottomToTop.indexOf(to);
  if (toIndex === -1) throw new BranchNotInStackError(void 0, { branch: to });
  const toMerge = bottomToTop.slice(0, toIndex + 1);
  const unmergeable = toMerge.find((branch) => !isMergeablePr(prByBranch[branch]));
  if ((0, import_helpers3.isNotNil)(unmergeable))
    throw new UnmergeableToError(void 0, {
      branch: unmergeable,
      reason: describeBlockedPr(prByBranch[unmergeable])
    });
  const above = bottomToTop[toIndex + 1];
  const endBranch = (0, import_helpers3.isNotNil)(above) && hasOpenPr(prByBranch[above]) ? above : null;
  return { toMerge, endBranch };
};
var formatMergePlanLine = (branch, pr) => (0, import_helpers3.isNotNil)(pr) ? `#${pr.prNumber} ${pr.title} (${branch})` : branch;
var isMergeablePr = (pr) => (0, import_helpers3.isNotNil)(pr) && pr.state === "OPEN" && pr.isDraft === false && !isMarkedDoNotMerge(pr);
var isMarkedDoNotMerge = (pr) => (
  // People type the marker by hand, so any casing counts.
  pr.title.trimStart().toLowerCase().startsWith(DO_NOT_MERGE_MARKER)
);
var describeBlockedPr = (pr) => (0, import_helpers3.isNotNil)(pr) && isMarkedDoNotMerge(pr) ? `is marked ${DO_NOT_MERGE_MARKER}` : "has no open PR (closed, merged, or unsubmitted)";
var splitMergeableRange = (toMerge, prByBranch) => {
  const [mergeable, blocked] = splitWhen_default((branch) => !isMergeablePr(prByBranch[branch]), toMerge);
  return { mergeable, blocked };
};
var planMergeRange = (range, prByBranch) => {
  const { mergeable, blocked } = splitMergeableRange(range.toMerge, prByBranch);
  const endBranch = resolveEndBranch(blocked, range.endBranch, prByBranch);
  return { mergeable: { toMerge: mergeable, endBranch }, blocked };
};
var resolveEndBranch = (blocked, endBranch, prByBranch) => {
  const [firstBlocked] = blocked;
  if ((0, import_helpers3.isNil)(firstBlocked)) return endBranch;
  return hasOpenPr(prByBranch[firstBlocked]) ? firstBlocked : null;
};
var hasOpenPr = (pr) => pr?.state === "OPEN";
var runGate = async () => {
  const guard = await runSyncGuard();
  if (guard.blocked) return { clean: false, stage: "sync-guard", output: guard.output };
  const refresh = await refreshPrCache();
  if (!refresh.refreshed) return { clean: false, stage: "sync", output: refresh.output };
  const restackFailure = await runOrCaptureFailure(() => $`gt restack --no-interactive`);
  if ((0, import_helpers3.isNil)(restackFailure)) return { clean: true };
  await runOrCaptureFailure(() => $`gt abort -f`);
  return { clean: false, stage: "restack", output: restackFailure.output };
};
var runSyncGuard = async () => {
  const failure = await runOrCaptureFailure(() => $`gt-sync-check`);
  if ((0, import_helpers3.isNil)(failure) || failure.exitCode !== SYNC_GUARD_REFUSED) return { blocked: false };
  return { blocked: true, output: failure.output };
};
var SYNC_GUARD_REFUSED = 1;
var refreshPrCache = async () => {
  const failure = await runOrCaptureFailure(() => $`gt sync -d --no-restack --no-interactive`);
  return (0, import_helpers3.isNil)(failure) ? { refreshed: true } : { refreshed: false, output: failure.output };
};
var runOrCaptureFailure = async (cmd) => {
  try {
    await cmd();
    return null;
  } catch (thrown) {
    return { output: extractOutput(thrown), exitCode: extractExitCode(thrown) };
  }
};
var extractOutput = (thrown) => {
  if (hasStdStreams(thrown)) return `${thrown.stdout}
${thrown.stderr}`.trim();
  return (0, import_helpers4.guaranteedError)(thrown).message;
};
var NO_EXIT_CODE = -1;
var extractExitCode = (thrown) => hasExitCode(thrown) ? thrown.exitCode : NO_EXIT_CODE;
var hasStdStreams = (value) => typeof value === "object" && (0, import_helpers3.isNotNil)(value) && "stdout" in value && "stderr" in value;
var hasExitCode = (value) => typeof value === "object" && (0, import_helpers3.isNotNil)(value) && "exitCode" in value;
var MERGE_READINESS_DELAYS_MS = [500, 1e3, 1500, 2e3, 2500, 2500, 2500, 2500];
var mergeStack = async (opts) => {
  const first = (0, import_helpers3.just)(opts.toMerge[0], "merge range must be non-empty");
  await $`gt checkout ${first.branch}`;
  for (const [index, target] of opts.toMerge.entries()) {
    await mergePr(
      target.prNumber,
      opts.trunk,
      opts.mergeReadinessDelaysMs ?? MERGE_READINESS_DELAYS_MS
    );
    const next = opts.toMerge[index + 1];
    if ((0, import_helpers3.isNil)(next)) {
      break;
    }
    await $`gt checkout ${next.branch}`;
    await $`gt sync -d --no-restack --no-interactive`;
    await $`gt restack --no-interactive`;
    await $`gt submit --no-stack --no-interactive`;
  }
  return await finalizeTopOfRange(opts);
};
var mergePr = async (prNumber, trunk, delaysMs) => {
  const { baseRefName, mergeable, title } = await asyncRetryWith(
    () => readMergeReadiness(prNumber),
    {
      delaysMs,
      stopRetry: (readiness) => readiness.baseRefName === trunk && isSettledMergeable(readiness.mergeable)
    }
  );
  if (isMarkedDoNotMerge({ title })) throw new DoNotMergeError(void 0, { prNumber });
  if (baseRefName !== trunk)
    throw new UnexpectedMergeBaseError(void 0, { prNumber, baseRefName, trunk });
  if (!isSettledMergeable(mergeable))
    throw new MergeabilityUnknownError(void 0, { prNumber, mergeable });
  await $`gh pr merge ${String(prNumber)} -s --admin`;
};
var SETTLED_MERGEABLE_VERDICTS = ["MERGEABLE", "CONFLICTING"];
var isSettledMergeable = (mergeable) => SETTLED_MERGEABLE_VERDICTS.includes(mergeable);
var readMergeReadiness = async (prNumber) => {
  const result = await $`gh pr view ${String(prNumber)} --json baseRefName,mergeable,title -q '[.baseRefName, .mergeable, .title] | @tsv'`;
  const [baseRefName = "", mergeable = "", title = ""] = result.stdout.trim().split("	");
  return { baseRefName, mergeable, title };
};
var finalizeTopOfRange = async (opts) => {
  if ((0, import_helpers3.isNotNil)(opts.endBranch)) {
    await $`gt checkout ${opts.endBranch}`;
    await $`gt sync -d --no-restack --no-interactive`;
    await $`gt restack --no-interactive`;
    if (opts.submitRest) {
      await $`gt submit --stack --update-only --no-interactive`;
    }
    return { worktreeReadyForCleanup: false };
  }
  if (!opts.isWorktree) {
    await $`git checkout ${opts.trunk}`;
    await $`gt sync -d --no-restack --no-interactive`;
    return { worktreeReadyForCleanup: false };
  }
  return await runWorktreeCleanupDance(opts.trunk);
};
var runWorktreeCleanupDance = async (trunk) => {
  await $`gt sync --no-interactive --no-restack`;
  await $`git checkout --detach origin/${trunk}`;
  await $`gt sync -d --no-restack --no-interactive`;
  return { worktreeReadyForCleanup: true };
};

// modules/gather-cli/src/commands/stack/merge.ts
var StackMerge = class _StackMerge extends import_core2.Command {
  static summary = "Land the current Graphite stack onto trunk, bottom to top, after proving the whole stack restacks cleanly onto the latest origin/main";
  static description = [
    "Each PR lands with `gh pr merge --squash --admin`, which can bypass branch protection when you have the rights. It checks that each PR is mergeable and based on trunk. It doesn't check CI or approvals.",
    "",
    "Exit codes: 1 when the stack forks upstack, 2 when you're on trunk, the branch isn't tracked or the --to range is invalid, 3 when the Graphite repo config is missing or invalid, 4 when the sync or restack gate fails, 5 when a merge fails, and 6 when nothing in the range can merge. Other failures can exit 1 or 2 too."
  ].join("\n");
  static examples = [
    "# merge the whole stack",
    "$ <%= config.bin %> <%= command.id %>",
    "# merge only up to a given branch, leaving the rest of the stack",
    "$ <%= config.bin %> <%= command.id %> --to andrew/my-feature",
    "# skip the confirmation prompt",
    "$ <%= config.bin %> <%= command.id %> --force"
  ];
  static flags = {
    to: import_core2.Flags.string({ description: "top branch of the merge range (default: top of the stack)" }),
    plan: import_core2.Flags.boolean({
      description: "sync trunk, print the resolved merge plan, and exit without merging"
    }),
    force: import_core2.Flags.boolean({ description: "skip the confirmation prompt" }),
    "submit-rest": import_core2.Flags.boolean({
      allowNo: true,
      description: "submit every branch above the merged range that has a PR (if unset, prompts after --to, and submits when a blocked PR stops the merge)"
    })
  };
  async run() {
    const { flags } = await this.parse(_StackMerge);
    const commonDir = await gitCommonDir();
    const trunk = this.readTrunkOrError(path4.join(commonDir, ".graphite_repo_config"));
    const reader = buildSqliteReader(path4.join(commonDir, ".graphite_metadata.db"));
    const stack = await this.syncAndReadStack({ reader, commonDir, trunk });
    const range = this.resolveRangeOrError(stack, flags.to);
    const { mergeable: effectiveRange, blocked } = planMergeRange(range, stack.prByBranch);
    this.printPlan(effectiveRange.toMerge, blocked, trunk, stack.prByBranch);
    if (flags.plan) {
      Logger2.log("\nPreview only \u2014 nothing merged. Re-run without --plan to execute.");
      return;
    }
    if (isNilOrEmpty(effectiveRange.toMerge)) {
      const bottom = (0, import_helpers3.just)(range.toMerge[0], "merge range must be non-empty");
      const reason = describeBlockedPr(stack.prByBranch[bottom]);
      this.error(`Nothing to merge: bottom branch '${bottom}' ${reason}.`, { exit: 6 });
    }
    await verifyNoUncommittedChangesOrThrow();
    if (!flags.force) {
      await askYesNoQuestion(
        `
Land these ${effectiveRange.toMerge.length} branch(es) into '${trunk}'? (y/N): `
      );
    }
    const submitRest = await this.resolveSubmitRest(
      effectiveRange.endBranch,
      blocked,
      flags["submit-rest"]
    );
    await this.gateOrError(trunk);
    const result = await this.runMergeLoop(effectiveRange, submitRest, trunk, stack.prByBranch);
    this.reportFinalState(result.worktreeReadyForCleanup, effectiveRange, stack.fullStack);
  }
  // Graphite's PR cache doesn't see a PR marked ready or retitled on GitHub until a sync, so the
  // plan reads it right after one.
  async syncAndReadStack(sources) {
    const startBranch = await currentBranch();
    if (startBranch === sources.trunk) {
      this.error(`Run from a branch in the stack, not '${sources.trunk}'.`, { exit: 2 });
    }
    await verifyNoUncommittedChangesOrThrow();
    const refresh = await refreshPrCache();
    if (!refresh.refreshed) {
      this.errorSyncFailed(sources.trunk, refresh.output);
    }
    return await this.readSyncedStack(sources, startBranch);
  }
  // Re-reads the current branch, because the sync deletes the branch we started on once its PR
  // lands.
  async readSyncedStack(sources, startBranch) {
    const branch = await currentBranch();
    if (branch === sources.trunk) {
      this.error(
        `The sync deleted '${startBranch}', the branch you were on, because its PR landed. Check out another branch in the stack and re-run.`,
        { exit: 2 }
      );
    }
    const fullStack = await this.resolveStack(sources.reader, branch, sources.trunk);
    const prInfos = safeReadPrInfos(path4.join(sources.commonDir, ".graphite_pr_info"));
    return { fullStack, prByBranch: indexBy_default((pr) => pr.headRefName, prInfos) };
  }
  readTrunkOrError(repoConfigPath) {
    try {
      return readTrunk(repoConfigPath);
    } catch {
      this.error(
        "Graphite repo config not found or invalid. Is this a Graphite-tracked repository?",
        { exit: 3 }
      );
    }
  }
  async resolveStack(reader, startBranch, trunk) {
    try {
      return await buildFullStack(reader, startBranch, trunk);
    } catch (e) {
      if (e instanceof ForkError) {
        const childList = e.metadata.children.map((c) => `  - ${c}`).join("\n");
        this.error(
          `fork upstack at ${e.metadata.branch}: ${e.metadata.children.length} children. Check out one branch as the tip and retry:
${childList}`,
          { exit: 1 }
        );
      }
      if (e instanceof UntrackedBranchError) {
        this.error(
          `branch '${e.metadata.branch}' is not tracked by Graphite. Run \`gt track\` to track it.`,
          { exit: 2 }
        );
      }
      throw e;
    }
  }
  resolveRangeOrError(stack, to) {
    try {
      return resolveMergeRange(stack.fullStack, to, stack.prByBranch);
    } catch (e) {
      if (e instanceof BranchNotInStackError || e instanceof UnmergeableToError) {
        this.error(e.message, { exit: 2 });
      }
      throw e;
    }
  }
  async gateOrError(trunk) {
    const gate = await runGate();
    if (gate.clean) return;
    Logger2.log("");
    if (gate.stage === "sync-guard") {
      this.error(
        [
          "Another worktree has work that this merge's syncs would discard. Nothing was changed.",
          "",
          gate.output
        ].join("\n"),
        { exit: 4 }
      );
    }
    if (gate.stage === "sync") {
      this.errorSyncFailed(trunk, gate.output);
    }
    this.error(
      [
        `Stack did not restack cleanly onto the latest '${trunk}'. We aborted the merge and returned everything to the starting state.`,
        "",
        `Restack, fix the merge conflicts, submit, and then re-run \`${this.commandLine}\` again.`
      ].join("\n"),
      { exit: 4 }
    );
  }
  errorSyncFailed(trunk, output) {
    this.error(
      [
        `Could not sync the latest '${trunk}'. Nothing was changed.`,
        "",
        output,
        "",
        `Resolve the issue above, then re-run \`${this.commandLine}\`.`
      ].join("\n"),
      { exit: 4 }
    );
  }
  async resolveSubmitRest(endBranch, blocked, flag) {
    if ((0, import_helpers3.isNil)(endBranch)) return false;
    if ((0, import_helpers3.isNotNil)(flag)) return flag;
    if (isNotEmpty(blocked)) return true;
    return await askYesNoQuestionWithDefault(
      `Submit the rest of the stack, from '${endBranch}' up, after merging?`,
      false
    );
  }
  async runMergeLoop(range, submitRest, trunk, prByBranch) {
    const isWorktree = await isInWorktree();
    try {
      return await mergeStack({
        toMerge: this.toMergeTargets(range.toMerge, prByBranch),
        endBranch: range.endBranch,
        submitRest,
        isWorktree,
        trunk
      });
    } catch (e) {
      if (e instanceof UnexpectedMergeBaseError) {
        this.error(
          [
            e.message,
            "",
            `Re-run \`${this.commandLine}\` once the PR is retargeted onto trunk.`
          ].join("\n"),
          { exit: 5 }
        );
      }
      this.error(`Merge stopped: ${(0, import_helpers4.guaranteedError)(e).message}`, { exit: 5 });
    }
  }
  get commandLine() {
    return `${this.config.bin} ${this.id}`;
  }
  // `planMergeRange` already dropped every branch without a mergeable PR, so each remaining branch
  // has one — but that guarantee lives in a filter the compiler can't see, so pin it here rather
  // than letting a missing number reach `gh pr merge` as an inferred target.
  toMergeTargets(toMerge, prByBranch) {
    return toMerge.map((branch) => ({
      branch,
      prNumber: (0, import_helpers3.just)(
        prByBranch[branch]?.prNumber,
        `no PR number for '${branch}', which the merge plan listed as mergeable`
      )
    }));
  }
  printPlan(mergeable, blocked, trunk, prByBranch) {
    Logger2.log(`Merge plan \u2014 landing onto '${trunk}', bottom to top:`);
    mergeable.forEach(
      (branch, index) => Logger2.log(`  ${index + 1}. ${formatMergePlanLine(branch, prByBranch[branch])}`)
    );
    const [firstBlocked] = blocked;
    if ((0, import_helpers3.isNotNil)(firstBlocked)) {
      const reason = describeBlockedPr(prByBranch[firstBlocked]);
      Logger2.log(`
Not merging '${firstBlocked}', which ${reason}, or anything above it:`);
      blocked.forEach(
        (branch) => Logger2.log(`  - ${formatMergePlanLine(branch, prByBranch[branch])}`)
      );
    }
  }
  reportFinalState(worktreeReadyForCleanup, range, fullStack) {
    const remaining = fullStack.filter((branch) => !range.toMerge.includes(branch));
    if (isNotEmpty(remaining)) {
      Logger2.log("\nRemaining stack (not merged):");
      remaining.forEach((branch) => Logger2.log(`  ${branch}`));
    }
    if (worktreeReadyForCleanup) {
      Logger2.log("\nThis worktree is ready to be cleaned up.");
    }
  }
};

// modules/gather-cli/src/engWorkflow/entries/runEntry.ts
var import_path7 = __toESM(require("path"));
var import_core3 = __toESM(require_lib());
var runEntry = async (bin) => {
  try {
    await (0, import_core3.run)(process.argv.slice(2), {
      root: __dirname,
      pjson: {
        name: bin,
        version: "0.0.0",
        oclif: {
          bin,
          commands: {
            strategy: "explicit",
            target: `./${import_path7.default.basename(__filename)}`,
            identifier: "COMMANDS"
          }
        }
      }
    });
    await (0, import_core3.flush)();
  } catch (error) {
    await import_core3.Errors.handle(error instanceof Error ? error : new Error(String(error)));
  }
};

// modules/gather-cli/src/engWorkflow/entries/gtStack.ts
var COMMANDS = { list: StackList, merge: StackMerge };
runEntry("gt-stack");
// Annotate the CommonJS export names for ESM import in node:
0 && (module.exports = {
  COMMANDS
});
