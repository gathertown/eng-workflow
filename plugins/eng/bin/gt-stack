// modules/gather-common/src/zx-helpers.ts
var askYesNoQuestion = async (prompt) => {
  const res = await question(prompt);
  if (res.toLowerCase() !== "y") throw new Error("Did not answer Y or y. Exiting...");
};
var askYesNoQuestionWithDefault = async (prompt, defaultYes) => {
  const res = await question(prompt + ` ${defaultYes ? "(Y/n) " : "(y/N) "}`);
  return res.toLowerCase() === "y" || res === "" && defaultYes;
};
var getOutput = async (cmd) => {
  const processOutput = await cmd;
  if ((0, import_helpers3.isNil)(processOutput)) {
    console.error("tried to get shell output of unmocked zx ($) command");
    console.log("Received command:", formatShellCommandForMocking(...$._lastCommand));
    throw new Error("tried to get shell output of unmocked zx ($) command");
  }
  return processOutput.stdout.trim();
};
var getOutputSilent = async (cmd) => await runSilent(async () => await getOutput(cmd()));
var runSilent = async (cmd) => {
  const prevVerbose = $.verbose;
  $.verbose = false;
  try {
    return await cmd();
  } finally {
    $.verbose = prevVerbose;
  }
};
var nonEmptyResponse = ifElse_default(
  isNotNilAndNotEmpty,
  always_default(true),
  always_default("Response required")
);
var formatShellCommandForMocking = (pieces, ...args) => isEmpty(args) ? pieces[0] : [pieces, ...args];

