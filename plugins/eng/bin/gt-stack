    var require_parse4 = __commonJS2({
      "node_modules/braces/lib/parse.js"(exports22, module22) {
        "use strict";
        var stringify5 = require_stringify();
        var {
          MAX_LENGTH,
          CHAR_BACKSLASH,
          /* \ */
          CHAR_BACKTICK,
          /* ` */
          CHAR_COMMA,
          /* , */
          CHAR_DOT,
          /* . */
          CHAR_LEFT_PARENTHESES,
