#!/usr/bin/env bash
# marker: GATHER_GT_WRAPPER

# Serializes Graphite writes across every worktree sharing this repo's git
# common directory, then runs the real gt.
#
# Linked worktrees have their own HEAD, index and rebase state but share branch
# refs and Graphite's metadata, so two concurrent `gt` writes can leave a branch
# pointing behind work another worktree just committed.
#
# This is cooperative: it only protects invocations that resolve through here.
# An absolute /opt/homebrew/bin/gt, raw git, an IDE, or GT_NO_LOCK=1 all still
# write refs. `bin/gt-audit` is what covers those.
#
# The lock serializes writes. It does not scope them, and a forced or confirmed
# `gt sync` rewrites branches nobody asked it about, so `sync` is checked before it runs.
# `bin/lib/gt-sync-guard.sh` explains what it refuses.
#
# Environment:
#   GT_NO_LOCK=1        Skip locking entirely (emergency escape hatch)
#   GT_SYNC_RESET_OK=1  Run `sync` even when it would reset another worktree's work
#   GT_LOCK_TIMEOUT     Seconds to wait for the lock (default 300)
#   GT_REAL_BIN         Absolute path to the real Graphite binary
#   GT_ALIAS_FILE       Graphite alias file (default ~/.config/graphite/aliases)

set -uo pipefail

readonly DEFAULT_TIMEOUT=300

# How long each acquisition attempt blocks before the heartbeat prints. Waiters
# leave and re-enter the kernel queue between chunks, so this is not FIFO.
readonly WAIT_CHUNK=10

# Substrings that identify this wrapper and the generated global shim, so the
# real-binary search can never select one of them. Missing the shim's marker is
# a hang, not an error: PATH resolution is bin/gt -> mise shim -> generated
# shim -> bin/gt, and the loop never terminates.
readonly SELF_MARKER="GATHER_GT_WRAPPER"
readonly GENERATED_SHIM_MARKER="Auto-generated by install-global-to-local-shim"

# Commands that only read shared state or write this worktree's own HEAD and
# index. Everything else locks, including anything unrecognized.
#
# Navigation is exempt on a tradeoff: a foreign restack can move a ref between
# resolution and checkout, which self-corrects on the next command, and locking
# it would put routine navigation behind a 60s `gt submit` elsewhere.
readonly EXEMPT_SUBCOMMANDS="\
log l ls ll info children parent pr dash docs changelog guide g feedback completion fish \
checkout co up u down d top t bottom b"

SELF_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
REAL_GT=""

# shellcheck source=./lib/stdlib.sh
source "$(dirname "$SELF_PATH")/lib/stdlib.sh"
# shellcheck source=./lib/gt-lock.sh
source "$(dirname "$SELF_PATH")/lib/gt-lock.sh"
# shellcheck source=./lib/gt-sync-guard.sh
source "$(dirname "$SELF_PATH")/lib/gt-sync-guard.sh"

# stdlib exports ROOT_DIR resolved from $PWD, and `gt --cwd` runs its hooks in
# another worktree. Nothing here reads it, so drop it and let hooks resolve their
# own the way they do without this wrapper in the chain.
unset ROOT_DIR

die() {
  echo "gt: $1" >&2
  exit 1
}

# The markers below are the only thing keeping the real-binary search from
# selecting another wrapper, and the price of missing one is a hang rather than
# an error. Count invocations so a chain we failed to anticipate fails loudly.
# Legitimate nesting is a gt running under a git hook, two or three deep.
GT_WRAPPER_DEPTH=$((${GT_WRAPPER_DEPTH:-0} + 1))
export GT_WRAPPER_DEPTH
[[ "$GT_WRAPPER_DEPTH" -le 5 ]] ||
  die "resolved to itself $GT_WRAPPER_DEPTH times; PATH has a gt wrapper this script doesn't recognize"

# --- Resolving the real Graphite binary --------------------------------------

# canonicalize follows symlinks by hand, because realpath and readlink -f are
# not portable across the platforms this repo runs on.
canonicalize() {
  local path="$1" target hops=0
  while [[ -L "$path" && "$hops" -lt 32 ]]; do
    target="$(readlink "$path")" || return 1
    [[ "$target" == /* ]] || target="$(dirname "$path")/$target"
    path="$target"
    hops=$((hops + 1))
  done
  local dir
  dir="$(cd "$(dirname "$path")" 2>/dev/null && pwd -P)" || return 1
  printf '%s' "${dir%/}/$(basename "$path")"
}

# set_real_gt accepts a candidate only if it is a real Graphite install. It
# rejects this wrapper, the generated global shim, and mise shims — those are
# symlinks to the mise binary itself, so a marker search alone would take one
# for Graphite and loop back here.
set_real_gt() {
  local resolved
  resolved="$(canonicalize "$1")" || return 1

  [[ -f "$resolved" && -x "$resolved" ]] || return 1
  [[ "$resolved" != "$SELF_PATH" ]] || return 1
  [[ "$(basename "$resolved")" != "mise" ]] || return 1

  # Only a script can be one of our wrappers, so binaries skip the read.
  if [[ "$(head -c 2 "$resolved" 2>/dev/null)" == "#!" ]]; then
    if head -c 1024 "$resolved" 2>/dev/null |
      LC_ALL=C grep -qs -e "$SELF_MARKER" -e "$GENERATED_SHIM_MARKER"; then
      return 1
    fi
  fi

  # Symlinks are followed to decide whether this is the real Graphite, but the
  # path handed to exec is the one given. Homebrew's /opt/homebrew/bin/gt points
  # into a versioned Cellar directory that `brew upgrade` deletes, and this
  # resolves before a lock wait that can outlast an upgrade.
  REAL_GT="$1"
}

resolve_real_gt() {
  if [[ -n "${GT_REAL_BIN:-}" ]]; then
    set_real_gt "$GT_REAL_BIN" ||
      die "GT_REAL_BIN=$GT_REAL_BIN is not a usable Graphite binary"
    return 0
  fi

  local entry
  local IFS=:
  for entry in $PATH; do
    # An empty or relative PATH entry means somewhere under the current
    # directory, which is never a Graphite install.
    [[ "$entry" == /* ]] || continue
    [[ -x "$entry/gt" ]] || continue
    set_real_gt "$entry/gt" && return 0
  done
  return 1
}

run_real_gt() {
  resolve_real_gt || die "could not find the real Graphite binary on PATH"
  exec "$REAL_GT" "$@"
}

# --- Argument parsing --------------------------------------------------------

# Graphite accepts --cwd before or after the subcommand and it really retargets,
# so scanning leading flags alone would lock repo A while mutating repo B.
# --cwd is the only global option that takes a value.
CWD_VALUES=()
SUBCOMMAND=""
HELP_REQUESTED=false
parse_argv() {
  local seen_subcommand=false arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    shift
    case "$arg" in
    --)
      break
      ;;
    --cwd)
      # A trailing --cwd with no value is ignored by Graphite too.
      [[ $# -gt 0 ]] || break
      CWD_VALUES+=("$1")
      shift
      ;;
    --cwd=*)
      CWD_VALUES+=("${arg#--cwd=}")
      ;;
    --help | -h | --version | -v)
      HELP_REQUESTED=true
      ;;
    -*) ;;
    *)
      if [[ "$seen_subcommand" == false ]]; then
        SUBCOMMAND="$arg"
        seen_subcommand=true
      fi
      ;;
    esac
  done
}

# resolve_alias expands a user alias to the command it runs, so an alias that
# shadows an exempt token can't smuggle a mutating command past the safe list.
resolve_alias() {
  local token="$1" alias_file="${GT_ALIAS_FILE:-$HOME/.config/graphite/aliases}" expansion
  if [[ -z "$token" || ! -r "$alias_file" ]]; then
    printf '%s' "$token"
    return
  fi
  expansion="$(awk -v want="$token" '!/^#/ && $1 == want { print $2; exit }' "$alias_file" 2>/dev/null)"
  printf '%s' "${expansion:-$token}"
}

is_exempt() {
  local token
  [[ "$HELP_REQUESTED" == false ]] || return 0
  [[ -n "$SUBCOMMAND" ]] || return 0
  token="$(resolve_alias "$SUBCOMMAND")"
  [[ " $EXEMPT_SUBCOMMANDS " == *" $token "* ]]
}

# --- Repo identity -----------------------------------------------------------

# find_repo_root prints the top of the work tree holding $1, and fails outside one.
find_repo_root() {
  git -C "$1" rev-parse --show-toplevel 2>/dev/null
}

# --- Locking -----------------------------------------------------------------

random_id() {
  head -c 8 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n'
}

# write_holder publishes diagnostic attribution by atomic rename. Every reader
# treats this as a hint: the lock can be held while the record is absent, stale,
# or describes a process that has already exited.
write_holder() {
  local tmp="$HOLDER.$$.tmp"
  (
    umask 077
    {
      echo "version=1"
      echo "common_dir=$COMMON_DIR"
      echo "worktree=$REPO_ROOT"
      echo "branch=$(git -C "$EFFECTIVE_CWD" rev-parse --abbrev-ref HEAD 2>/dev/null)"
      echo "subcommand=$SUBCOMMAND"
      echo "pid=$$"
      echo "child_pid=$CHILD_PID"
      echo "uid=$(id -u)"
      echo "start_time=$(ps -o lstart= -p $$ 2>/dev/null | tr -d '\n')"
      echo "acquired=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      echo "invocation=$INVOCATION_ID"
    } >"$tmp" 2>/dev/null
  )
  mv -f "$tmp" "$HOLDER" 2>/dev/null || rm -f "$tmp" 2>/dev/null
}

holder_field() {
  [[ -r "$HOLDER" ]] || return 1
  awk -F= -v key="$1" '$1 == key { print substr($0, length(key) + 2); exit }' "$HOLDER" 2>/dev/null
}

describe_holder() {
  local worktree subcommand pid
  worktree="$(holder_field worktree)"
  subcommand="$(holder_field subcommand)"
  pid="$(holder_field pid)"
  if [[ -z "$worktree$subcommand$pid" ]]; then
    printf 'an unidentified holder'
    return
  fi
  printf '%s' "gt ${subcommand:-?} (pid ${pid:-?}) in ${worktree:-an unknown worktree}"
}

# --- Main --------------------------------------------------------------------

parse_argv "$@"

# GT_NO_LOCK skips serialization, not the reset check, so a sync still goes through the guard below
# before this bypasses the lock. GT_SYNC_RESET_OK is the guard's own escape hatch.
if [[ "${GT_NO_LOCK:-}" == "1" && "$(resolve_alias "$SUBCOMMAND")" != "sync" ]]; then
  run_real_gt "$@"
fi

if is_exempt; then
  run_real_gt "$@"
fi

if [[ "${#CWD_VALUES[@]}" -gt 1 ]]; then
  die "--cwd was given more than once; Graphite joins those into one invalid path"
fi

EFFECTIVE_CWD="$PWD"
if [[ "${#CWD_VALUES[@]}" -eq 1 ]]; then
  EFFECTIVE_CWD="${CWD_VALUES[0]}"
fi
# The audit log records the spelling the caller walked through, so the guard needs the path before
# the symlinks come out of it.
RAW_CWD="$EFFECTIVE_CWD"

# Graphite cannot mutate a directory that doesn't exist or a tree outside this
# repo, so both cases hand the invocation straight through.
EFFECTIVE_CWD="$(cd "$EFFECTIVE_CWD" 2>/dev/null && pwd -P)" || run_real_gt "$@"
REPO_ROOT="$(find_repo_root "$EFFECTIVE_CWD")" || run_real_gt "$@"

COMMON_DIR="$(common_git_dir "$EFFECTIVE_CWD")" ||
  die "could not resolve the git common directory for $EFFECTIVE_CWD"

# Refuse before taking the lock, so a sync that is going to be turned away never makes anyone wait.
if [[ "$(resolve_alias "$SUBCOMMAND")" == "sync" ]]; then
  sync_guard_check "$RAW_CWD" "$COMMON_DIR"
  guard_status=$?
  [[ "$guard_status" -ne 1 ]] || exit 1
fi

# The sync case reaches here only after the guard above cleared it.
if [[ "${GT_NO_LOCK:-}" == "1" ]]; then
  run_real_gt "$@"
fi

LOCK="$COMMON_DIR/$LOCK_BASENAME"
HOLDER="$LOCK.holder"

# Reentrancy is scoped to this exact lock, so a nested `gt --cwd other-repo`
# still takes that repo's lock.
if [[ "${GT_LOCK_HELD:-}" == "$LOCK" ]]; then
  run_real_gt "$@"
fi

TIMEOUT="${GT_LOCK_TIMEOUT:-$DEFAULT_TIMEOUT}"
if [[ ! "$TIMEOUT" =~ ^[0-9]+$ ]] || [[ "$TIMEOUT" -gt 86400 ]]; then
  die "GT_LOCK_TIMEOUT must be a whole number of seconds from 0 to 86400, got '$TIMEOUT'"
fi

LOCK_TOOL="$(select_lock_tool)" ||
  die "neither flock nor lockf is available, so '$SUBCOMMAND' cannot be serialized safely"

# `exec {fd}>` needs bash 4.1, and without it there is no way to hold the lock
# for the length of the command, so a mutating command must not run.
if [[ "${BASH_VERSINFO[0]}" -lt 4 ]] ||
  { [[ "${BASH_VERSINFO[0]}" -eq 4 ]] && [[ "${BASH_VERSINFO[1]}" -lt 1 ]]; }; then
  die "bash $BASH_VERSION is too old to hold the lock; bash 4.1 or newer is required.
  Put a newer bash, e.g. Homebrew's, ahead of /bin/bash on PATH.
  Don't reach for GT_NO_LOCK to get past this — that runs the write unserialized."
fi

# A symlink here would make the redirection truncate whatever it points at, and
# replacing the inode silently breaks the lock for everyone already holding it.
if [[ -L "$LOCK" ]]; then
  die "$LOCK is a symlink; remove it and let gt recreate the file"
fi
if [[ -e "$LOCK" && ! -f "$LOCK" ]]; then
  die "$LOCK is not a regular file"
fi

resolve_real_gt || die "could not find the real Graphite binary on PATH"

exec {LOCK_FD}>>"$LOCK" || die "could not open $LOCK for writing"

INVOCATION_ID="$(random_id)"

deadline=$((SECONDS + TIMEOUT))
announced=false
announced_invocation=""
while true; do
  remaining=$((deadline - SECONDS))
  [[ "$remaining" -ge 0 ]] || remaining=0
  wait_for="$remaining"
  [[ "$wait_for" -le "$WAIT_CHUNK" ]] || wait_for="$WAIT_CHUNK"

  lock_attempt "$wait_for" "$LOCK_FD" "$LOCK_TOOL"
  status=$?
  [[ "$status" -ne 0 ]] || break

  if [[ "$status" -gt 128 ]]; then
    exit "$status"
  fi
  if [[ "$status" -ne "$CONTENTION_STATUS" ]]; then
    die "$LOCK_TOOL failed with status $status while acquiring $LOCK"
  fi
  if [[ "$remaining" -le "$wait_for" ]]; then
    echo "gt: timed out after ${TIMEOUT}s waiting for $LOCK" >&2
    echo "  held by: $(describe_holder)" >&2
    echo "  inspect: gt-unlock" >&2
    exit 1
  fi
  # The lock is not FIFO, so the holder can change while we wait. Saying so tells a long wait apart
  # from a bypass.
  current_invocation="$(holder_field invocation)"
  if [[ "$announced" == false ]]; then
    announced=true
    announced_invocation="$current_invocation"
    echo "gt: waiting on $(describe_holder)" >&2
  elif [[ -n "$current_invocation" && "$current_invocation" != "$announced_invocation" ]]; then
    announced_invocation="$current_invocation"
    echo "gt: now waiting on $(describe_holder)" >&2
  else
    echo "gt: still waiting ($((TIMEOUT - remaining))s)" >&2
  fi
done

# Re-check now that the lock is actually held. The check above ran before the wait, and the wait is
# not FIFO and can last up to GT_LOCK_TIMEOUT, which is exactly the window another worktree can move
# a branch in and make the first answer stale.
if [[ "$(resolve_alias "$SUBCOMMAND")" == "sync" ]]; then
  sync_guard_check "$RAW_CWD" "$COMMON_DIR"
  guard_status=$?
  [[ "$guard_status" -ne 1 ]] || exit 1
fi

export GT_LOCK_HELD="$LOCK"

# Run gt as a child with the lock descriptor closed. `exec` would leak it into
# gt's whole descendant tree, and a BSD flock releases only when the last
# inherited duplicate closes, so an orphaned git, editor or credential helper
# could hold the lock long after gt itself was gone.
#
# `0<&0` keeps stdin, because POSIX points an async job's stdin at /dev/null when
# job control is off and gt won't prompt without a TTY. `set -m` fixes that too,
# but puts the child in its own process group where a tty read takes SIGTTIN.
"$REAL_GT" "$@" 0<&0 {LOCK_FD}>&- &
child=$!

# The record is published after the spawn so it can name the child. A SIGKILL on
# this wrapper releases the lock without stopping gt, so `gt-unlock` needs the
# child's pid to end the mutation before the lock changes hands.
CHILD_PID="$child"
write_holder

trap 'kill -INT "$child" 2>/dev/null' INT
trap 'kill -TERM "$child" 2>/dev/null' TERM
trap 'kill -HUP "$child" 2>/dev/null' HUP

# A trap makes `wait` return early with 128+signal while the child is still
# running, so keep waiting until it reports the child's own status.
wait "$child"
status=$?
while [[ "$status" -gt 128 ]] && kill -0 "$child" 2>/dev/null; do
  wait "$child"
  status=$?
done

exit "$status"
