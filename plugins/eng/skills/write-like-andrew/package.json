{
  "name": "write-like-andrew",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "nx": {
    "targets": {
      "build:types": {
        "command": "tsc --noEmit",
        "inputs": [
          "sharedGlobals",
          "{projectRoot}/src/**/*",
          "{projectRoot}/testHelpers/**/*",
          "{projectRoot}/**/*.ts",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/package.json",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "dependentTasksOutputFiles": "**/*.d.ts",
            "transitive": true
          }
        ],
        "outputs": []
      }
    }
  },
  "devDependencies": {
    "@swc/core": "~1.15.36",
    "@swc/jest": "^0.2.39",
    "@types/jest": "~29.5.14",
    "@types/node": "~26.6.6",
    "@typescript/native": "npm:typescript@~7.0.2",
    "jest": "~30.1.3"
  }
}
